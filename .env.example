# Copiar a .env y completar. .env está en .gitignore: nunca se versiona.

# --- PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=aquanqa
PGUSER=postgres
PGPASSWORD=
PGCLIENTENCODING=UTF8

# Rol de la aplicación (escribe en core). Se crea en 00_bootstrap.
APP_DB_USER=aquanqa_app
APP_DB_PASSWORD=
# Rol de Power BI (solo lectura sobre reporting).
BI_DB_USER=aquanqa_bi
BI_DB_PASSWORD=
# Rol del ETL (escribe en raw).
ETL_DB_USER=aquanqa_etl
ETL_DB_PASSWORD=
# Rol del motor analítico: lee stg/core/fact y escribe analytics/mlflow.
ANALYTICS_DB_USER=aquanqa_analytics
ANALYTICS_DB_PASSWORD=

# Cadena de conexión que consume backend/campo-api (y domain/) con el rol de aplicación.
# El ETL no la usa: se conecta con las variables PG* de arriba, porque escribe en raw.
DATABASE_URL=postgresql://aquanqa_app:@localhost:5432/aquanqa
ANALYTICS_DATABASE_URL=postgresql://aquanqa_analytics:@localhost:5432/aquanqa
MLFLOW_BACKEND_STORE_URI=postgresql://aquanqa_analytics:@localhost:5432/aquanqa?options=-csearch_path%3Dmlflow
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_ARTIFACT_ROOT=data/salida/mlflow

# --- Orígenes de datos ---
# Copias Access autorizadas por campaña. Se abren SIEMPRE en solo lectura.
ACCESS_CAMPAIGN=C2026
ACCESS_DB_C2025_PATH=data/entrada/BD_AQUANQA_25_v2.accdb
ACCESS_DB_C2026_PATH=data/entrada/BD_AQUANQA_26.accdb
# Override opcional para una copia puntual; normalmente debe quedar vacío/no definido.
# ACCESS_DB_PATH=C:\ruta\copia_autorizada.accdb
# Maestro vigente de lotes.
MAESTRO_LOTES_PATH=data/entrada/M_Lotes.xlsx
# Copia local del tareo de SharePoint.
TAREO_PATH=data/entrada/Query Tareo 2026.xlsx
# Carpeta externa con los cuatro libros ProySemanal (solo para paridad/operación consciente).
# AQUANQA_OPERATIVO_ROOT=C:/datos/ProyeccionSemanal_33

# Destino de los CSV intermedios de extracción.
EXTRACT_DIR=data/salida

# --- Dashboard Dash ---
# Si son relativas, se resuelven desde la raíz detectada del repositorio.
# En un contenedor se puede fijar AQUANQA_REPO_ROOT=/app.
AQUANQA_XLSX=docs/data/IA.final.xlsx
AQUANQA_PODA_XLSX=docs/data/M_Poda.xlsx
AQUANQA_FLORACION_XLSX=docs/data/DAtos mes.xlsx
# postgres | excel | auto. En producción usar postgres; auto permite fallback local visible.
AQUANQA_ANALYTICS_SOURCE=auto

# --- Compatibilidad histórica ---
# Las páginas /modelo/* son un artefacto exploratorio de 2025 (XGBoost/SHAP/R²), no el
# módulo oficial de proyección: el oficial es /analitica/*, gobernado por ADR-0007.
# Ponlo en true para recuperar esas páginas bajo «Legacy / Exploración» cuando haga falta
# auditarlas o compararlas con las capturas de 2025. Por defecto queda en false.
AQUANQA_ENABLE_LEGACY_MODEL=false
