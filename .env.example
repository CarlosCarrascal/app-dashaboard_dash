# Copiar a .env y completar. .env está en .gitignore: nunca se versiona.

# --- PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=aquanqa
PGUSER=postgres
PGPASSWORD=
PGCLIENTENCODING=UTF8

# Rol de la aplicación (escribe en core). Se crea en 00_bootstrap.
APP_DB_USER=aquanqa_app
APP_DB_PASSWORD=
# Rol de Power BI (solo lectura sobre reporting).
BI_DB_USER=aquanqa_bi
BI_DB_PASSWORD=
# Rol del ETL (escribe en raw).
ETL_DB_USER=aquanqa_etl
ETL_DB_PASSWORD=

# Cadena de conexión que consume backend/campo-api (y domain/) con el rol de aplicación.
# El ETL no la usa: se conecta con las variables PG* de arriba, porque escribe en raw.
DATABASE_URL=postgresql://aquanqa_app:@localhost:5432/aquanqa

# --- Orígenes de datos ---
# Base Access de origen. Se abre SIEMPRE en solo lectura.
ACCESS_DB_PATH=C:\Users\CCARRASCAL\Downloads\Bd_Analisis\BD_AQUANQA_26.accdb
# Maestro vigente de lotes.
MAESTRO_LOTES_PATH=data/entrada/M_Lotes.xlsx
# Copia local del tareo de SharePoint.
TAREO_PATH=data/entrada/Query Tareo 2026.xlsx

# Destino de los CSV intermedios de extracción.
EXTRACT_DIR=data/salida

# --- Dashboard Dash ---
# Si son relativas, se resuelven desde la raíz detectada del repositorio.
# En un contenedor se puede fijar AQUANQA_REPO_ROOT=/app.
AQUANQA_XLSX=docs/data/IA.final.xlsx
AQUANQA_PODA_XLSX=docs/data/M_Poda.xlsx
AQUANQA_FLORACION_XLSX=docs/data/DAtos mes.xlsx
