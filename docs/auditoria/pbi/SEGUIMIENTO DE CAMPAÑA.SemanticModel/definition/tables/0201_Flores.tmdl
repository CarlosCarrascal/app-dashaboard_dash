	column FUNDO_CAMPO =
			
			SWITCH(
			    TRUE(),
			
			    '0201_Flores'[Modulo] IN {"M01","M02","M03","M04"},
			        "Arena Azul",
			
			    '0201_Flores'[Modulo] = "M05",
			        "Quri Allpa",
			
			    '0201_Flores'[Modulo] IN {"M06","M07","M08","M09","M10A","M10B","M11","M16"},
			        "Kawsay Allpa",
			
			    '0201_Flores'[Modulo] IN {"M12","M13","M14","M15"},
			        "Ayllu Allpa",
			
			    BLANK()
			)
		lineageTag: 01a9502b-c09c-49ae-8981-9e1795dfeb2b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

