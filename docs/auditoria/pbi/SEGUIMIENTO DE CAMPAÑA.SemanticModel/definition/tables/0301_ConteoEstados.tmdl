	column FUNDO_CAMPO =
			
			SWITCH(
			    TRUE(),
			
			    '0301_ConteoEstados'[Modulo] IN {"M01","M02","M03","M04"},
			        "Arena Azul",
			
			    '0301_ConteoEstados'[Modulo] = "M05",
			        "Quri Allpa",
			
			    '0301_ConteoEstados'[Modulo] IN {"M06","M07","M08","M09","M10A","M10B","M11","M16"},
			        "Kawsay Allpa",
			
			    '0301_ConteoEstados'[Modulo] IN {"M12","M13","M14","M15"},
			        "Ayllu Allpa",
			
			    BLANK()
			)
		lineageTag: 4549e532-d478-4e5a-813f-9b4f6f5f437e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

