table E02_ConteoFlores
	lineageTag: fa619554-ca32-4ed0-99e7-fc119bced246

	measure '# FLORES' = SUM(E02_ConteoFlores[nFlores])
		formatString: 0
		lineageTag: e5225c84-b5e1-4783-acdb-64d57617a803

	measure 'Total Flores' =
			
			SUM(E02_ConteoFlores[nFlores])
		formatString: #,0
		lineageTag: c5187e7b-a520-42fb-a225-cc83f1d675db

	measure 'Total Plantas' =
			
			COUNTROWS (
			    SUMMARIZE (
			        E02_ConteoFlores,
			        E02_ConteoFlores[Fecha],
			        E02_ConteoFlores[Evaluador],
			        E02_ConteoFlores[Fundo],
			        E02_ConteoFlores[Modulo],
			        E02_ConteoFlores[Lote],
			        E02_ConteoFlores[Cortina],
			        E02_ConteoFlores[Hilera],
			        E02_ConteoFlores[Planta]
			    )
			)
		formatString: #,0
		lineageTag: fc3e554f-de0d-42ac-b987-4534e231416f

	measure 'Flores por Hora' =
			
			DIVIDE(
			    [Total Flores],
			    [Horas Hombre Flores]
			)
		lineageTag: 3e7c72f6-746a-457c-b3ce-0f8ed76928b7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Evaluadores Activos' =
			
			DISTINCTCOUNT(E02_ConteoFlores[Evaluador])
		formatString: 0
		lineageTag: cbfbd9c8-141a-43c1-af05-7abb480442c0

	measure 'Flores por Evaluador' =
			
			DIVIDE(
			    [Total Flores],
			    [Evaluadores Activos]
			)
		lineageTag: 8ce898ae-97bc-42c2-aa0d-652a8e23af1d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Jornadas Evaluador' =
			
			COUNTROWS(
			    SUMMARIZE(
			        E02_ConteoFlores,
			        E02_ConteoFlores[Evaluador],
			        E02_ConteoFlores[Fecha]
			    )
			)
		formatString: 0
		lineageTag: cbd2adc3-73e3-4d53-8212-40b891b49e93

	measure 'Flores por Evaluador Día' =
			
			DIVIDE(
			    [Total Flores],
			    [Jornadas Evaluador]
			)
		lineageTag: b4118f8f-b162-4cbb-8379-856e1d5a0f6b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Frutos por Evaluador Día' =
			
			DIVIDE(
			    [Total Frutos],
			    [Jornadas Evaluador]
			)
		lineageTag: fef84420-e2fb-448c-ad85-b5793fed838e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Plantas por Evaluador Día' =
			
			DIVIDE(
			    [Total Plantas],
			    [Jornadas Evaluador]
			)
		lineageTag: 90a75147-8e8f-48df-8f1a-50aa4d858be1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Promedio Evaluador' =
			
			AVERAGE(E02_ConteoFlores[nFlores])
		lineageTag: 054f3bbd-975b-4758-bfee-220d0b930dd8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Desv Std Evaluador' =
			
			STDEV.P(E02_ConteoFlores[nFlores])
		lineageTag: 3d78da47-cce9-4232-9786-c0e50a9f88db

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CV Evaluador' =
			
			DIVIDE(
			    [Desv Std Evaluador],
			    [Promedio Evaluador]
			)
		lineageTag: 36f79eb3-2437-4dc4-addc-10190180c081

		annotation PBI_FormatHint = {"isGeneralNumber":true}

