		lineageTag: 67443935-355f-4402-9043-be815bba179e
		summarizeBy: sum
		sourceColumn: Hrs

		annotation SummarizationSetBy = Automatic

	column 'Nombre Corto' =
			
			VAR NombreCompleto = '2026'[Trabajador]
			VAR Palabras =
			    SUBSTITUTE(NombreCompleto, " ", "|")
			VAR P1 = PATHITEM(Palabras, 1, TEXT)
			VAR P3 = PATHITEM(Palabras, 3, TEXT)
			
			RETURN
			P1 & " " & P3
		lineageTag: bbb0d141-099f-4191-a005-5766ba2d5ffa
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Nombre Corto 2L' =
			
			VAR Pos = SEARCH(" ", '2026'[Nombre Corto],1)
			RETURN
			LEFT('2026'[Nombre Corto],Pos-1)
			&
			UNICHAR(10)
			&
			MID('2026'[Nombre Corto],Pos+1,LEN('2026'[Nombre Corto]))
		lineageTag: 5a71ff13-1183-41f0-93f0-9438050391da
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

