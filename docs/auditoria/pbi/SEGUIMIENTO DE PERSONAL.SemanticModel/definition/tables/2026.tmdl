		variation Variación
			isDefault
			relationship: 60ab6242-6366-419f-b5fa-221d603c2311
			defaultHierarchy: LocalDateTable_8182b126-b4f8-45bc-81a7-38e22cd563e4.'Jerarquía de fechas'

