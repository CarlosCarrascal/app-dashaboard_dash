table 2026
	lineageTag: 0c53d832-777f-4dc8-8dcd-126dc4f7a4c9

	measure 'HORAS TRABAJADAS' = SUM('2026'[Hrs])
		formatString: "S/"\ #,0.###############;-"S/"\ #,0.###############;"S/"\ #,0.###############
		lineageTag: 821f15ae-9b63-4ce6-869c-756c4aef4c4e

		annotation PBI_FormatHint = {"currencyCulture":"es-PE"}

	measure 'Horas Hombre Flores' =
			
			VAR Jornadas =
			    SUMMARIZE (
			        E02_ConteoFlores,
			        E02_ConteoFlores[Evaluador],
			        E02_ConteoFlores[Fecha]
			    )
			RETURN
			SUMX (
			    Jornadas,
			    CALCULATE (
			        MAX ( '2026'[Hrs] ),
			        TREATAS ( VALUES ( E02_ConteoFlores[Evaluador] ), '2026'[Documento] ),
			        TREATAS ( VALUES ( E02_ConteoFlores[Fecha] ), '2026'[Fecha] )
			    )
			)
		formatString: #,0.00
		lineageTag: 1f237e4f-cdd7-47bd-b450-4822a7910876

	column Documento
		dataType: string
		lineageTag: ffd073c4-326f-46c1-badd-ca6e28d31749
