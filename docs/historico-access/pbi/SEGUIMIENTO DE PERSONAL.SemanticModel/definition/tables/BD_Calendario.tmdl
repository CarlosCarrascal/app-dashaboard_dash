	partition BD_Calendario = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR ( DATE(2025,1,1), DATE(2028,12,31) ),
				
				    "Año", YEAR([Date]),
				    "Mes Nro", MONTH([Date]),
				    "Mes", FORMAT([Date], "MMMM"),
				    "Mes Corto", FORMAT([Date], "MMM"),
				
				    "Trimestre", "T" & FORMAT([Date], "Q"),
				
				    "Semana", WEEKNUM([Date], 2),
				
				    "Día", DAY([Date]),
				    "Día Semana Nro", WEEKDAY([Date], 2),
				    "Día Semana", FORMAT([Date], "dddd"),
				
				    "Año-Mes", FORMAT([Date], "YYYY-MM"),
				    "AñoMes", YEAR([Date]) * 100 + MONTH([Date]),
				
				    "Año-Semana",
				        YEAR([Date]) & "-" &
				        FORMAT(WEEKNUM([Date],2),"00")
				)

	annotation PBI_Id = 18a1a8ecf25742e3a2032114348b3b6f

