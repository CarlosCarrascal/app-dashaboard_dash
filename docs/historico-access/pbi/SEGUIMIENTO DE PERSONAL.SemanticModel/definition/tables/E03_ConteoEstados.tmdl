table E03_ConteoEstados
	lineageTag: 72eda90b-d8aa-4a71-8ad4-e6d572299fd1

	measure ESTADIOS = SUM(E03_ConteoEstados[Total])
		formatString: 0
		lineageTag: 5fe119b7-6802-4014-8798-a8fabe3eaa8e

	measure 'Total Frutos' =
			
			SUM(E03_ConteoEstados[Total])
		formatString: #,0
		lineageTag: 99597c8e-ea14-4370-aba9-6eace9537eb8

	measure 'Flores por Planta' =
			
			DIVIDE(
			    [Total Flores],
			    [Total Plantas]
			)
		lineageTag: ebd6c285-691c-4fef-9d41-e38bef73da97

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Frutos por Planta' =
			
			DIVIDE(
			    [Total Frutos],
			    [Total Plantas]
			)
		lineageTag: dae7a583-c7b6-43d8-98e4-163a3fa7d95f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Frutos por Hora' =
			
			DIVIDE(
			    [Total Frutos],
			    [Horas Hombre Flores]
			)
		lineageTag: 8dcc6d70-bac1-438f-8d98-ecd9a30b5982

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Plantas por Hora' =
			
			DIVIDE(
			    [Total Plantas],
			    [Horas Hombre Flores]
			)
		lineageTag: 1bee862d-6ec0-415c-a5bd-8e6f0276d50c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

