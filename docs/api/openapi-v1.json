  "info": {
    "description": "API interna para registrar evaluaciones de app-campo en PostgreSQL. El plan de distribución y el panel admin quedan fuera de esta primera versión.",
    "title": "Aqu Anqa · API de campo",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/catalogos/fundos": {
      "get": {
        "description": "Devuelve los fundos activos que la app puede presentar al evaluador.",
        "operationId": "listarFundos",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/FundoCatalogo"
                  },
                  "title": "Response Listarfundos",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "example": {
                  "detail": "No se pudo leer el catálogo de PostgreSQL"
                },
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "PostgreSQL no está disponible o el catálogo no pudo consultarse."
          }
        },
        "summary": "Lista fundos elegibles",
        "tags": [
          "Catálogos"
        ]
      }
    },
    "/v1/catalogos/lotes": {
      "get": {
        "description": "Filtra lotes activos, reales y elegibles por el módulo seleccionado.",
        "operationId": "listarLotes",
        "parameters": [
          {
            "description": "ID interno del módulo",
            "in": "query",
            "name": "modulo_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ID interno del módulo",
              "title": "Modulo Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/LoteCatalogo"
                  },
                  "title": "Response Listarlotes",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "example": {
                  "detail": "No se pudo leer el catálogo de PostgreSQL"
                },
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "PostgreSQL no está disponible o el catálogo no pudo consultarse."
          }
        },
        "summary": "Lista lotes por módulo",
        "tags": [
          "Catálogos"
        ]
      }
    },
    "/v1/catalogos/modulos": {
      "get": {
        "description": "Filtra los módulos elegibles por el fundo seleccionado.",
        "operationId": "listarModulos",
        "parameters": [
          {
            "description": "ID interno del fundo",
            "in": "query",
            "name": "fundo_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ID interno del fundo",
              "title": "Fundo Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
