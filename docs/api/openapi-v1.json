                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "example": {
                  "detail": "No se pudo leer el catálogo de PostgreSQL"
                },
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "PostgreSQL no está disponible o el catálogo no pudo consultarse."
          }
        },
        "summary": "Lista módulos por fundo",
        "tags": [
          "Catálogos"
        ]
      }
    },
    "/v1/evaluaciones": {
      "post": {
        "description": "Operación idempotente por client_id. El primer envío devuelve 201; un reenvío idéntico devuelve 200 y status=duplicate; reutilizar el UUID con otro contenido devuelve 409.",
        "operationId": "registrarEvaluacion",
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "captura_estadios": {
                  "summary": "Evaluación de estadios creada por Flutter",
                  "value": {
                    "cortina": 1,
                    "evaluador_dni": "10616663",
                    "fecha": "2026-08-31",
                    "hilera": 2,
                    "id": "11111111-1111-4111-8111-111111111111",
                    "lote_id": 12,
                    "module_key": "estadios",
                    "planta": 3,
                    "valores": {
                      "m1_e1": 1,
                      "m1_e2": 2,
                      "m1_e3": 3,
                      "m1_e4": 4,
                      "m1_e5": 5
                    }
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/EvaluationCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationReceipt"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "example": {
                  "detail": "client_id ya fue utilizado con otro módulo o contenido"
                },
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "El client_id ya fue usado con contenido diferente."
          },
          "422": {
            "content": {
              "application/json": {
                "examples": {
                  "payload_invalido": {
                    "value": {
                      "detail": [
                        {
                          "input": {},
                          "loc": [
                            "body",
                            "module_key"
                          ],
                          "msg": "Field required",
                          "type": "missing"
                        }
                      ]
                    }
                  },
                  "regla_negocio": {
                    "value": {
                      "detail": "lote_id no existe o no es elegible para captura"
                    }
                  }
                },
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ApiError"
                    },
                    {
                      "$ref": "#/components/schemas/HTTPValidationError"
                    }
                  ]
                }
              }
            },
            "description": "La captura o sus referencias de maestro no son válidas."
          },
          "503": {
            "content": {
              "application/json": {
                "example": {
                  "detail": "No se pudo guardar la evaluación en PostgreSQL"
                },
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "PostgreSQL no está disponible o la transacción falló."
          }
        },
        "summary": "Registra una evaluación y actualiza core",
        "tags": [
          "Evaluaciones"
        ]
      }
    },
    "/v1/evaluaciones/historial": {
      "get": {
        "description": "Consulta las evaluaciones históricas y móviles guardadas en las tablas core, sin duplicar reintentos de la app. Mientras no exista SSO, Flutter envía la identidad de su sesión; al incorporar JWT se obtendrá del token.",
        "operationId": "listarHistorialEvaluaciones",
        "parameters": [
          {
            "in": "query",
            "name": "evaluador_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Evaluador Id"
            }
          },
          {
            "in": "query",
            "name": "evaluador_dni",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 32,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Evaluador Dni"
            }
          },
          {
            "in": "query",
            "name": "module_key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "estadios",
                    "flores",
                    "baya",
                    "pesos",
                    "brotes",
                    "ramas"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Module Key"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationHistoryPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "examples": {
                  "payload_invalido": {
                    "value": {
                      "detail": [
                        {
                          "input": {},
                          "loc": [
                            "body",
                            "module_key"
                          ],
                          "msg": "Field required",
                          "type": "missing"
                        }
                      ]
                    }
                  },
                  "regla_negocio": {
                    "value": {
                      "detail": "se requiere evaluador_id o evaluador_dni"
                    }
                  }
                },
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ApiError"
                    },
                    {
                      "$ref": "#/components/schemas/HTTPValidationError"
                    }
                  ]
                }
              }
            },
            "description": "Faltan filtros de identidad o son inválidos."
          },
          "503": {
            "content": {
              "application/json": {
                "example": {
                  "detail": "No se pudo consultar el historial"
                },
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "PostgreSQL no está disponible."
          }
        },
        "summary": "Lista el historial completo de un evaluador",
        "tags": [
          "Evaluaciones"
        ]
      }
    },
    "/v1/evaluaciones/{client_id}": {
      "get": {
        "description": "Permite a Flutter reconciliar una captura después de un timeout o reintento.",
        "operationId": "consultarEvaluacion",
        "parameters": [
          {
            "in": "path",
            "name": "client_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Client Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationReceipt"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "example": {
                  "detail": "No existe una captura con ese client_id"
                },
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "No existe una captura aceptada con ese UUID."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "example": {
                  "detail": "No se pudo consultar la evaluación"
                },
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "PostgreSQL no está disponible."
          }
        },
        "summary": "Consulta el resultado de una captura local",
        "tags": [
          "Evaluaciones"
        ]
      }
    },
    "/v1/health/live": {
      "get": {
        "description": "No consulta dependencias externas.",
        "operationId": "comprobarProcesoVivo",
