          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Comprobarprocesovivo",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Comprueba que el proceso está vivo",
        "tags": [
          "Salud"
        ]
      }
    },
    "/v1/health/ready": {
      "get": {
        "description": "Devuelve 200 solo si la API puede ejecutar una consulta mínima en PostgreSQL.",
        "operationId": "comprobarPostgresDisponible",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Comprobarpostgresdisponible",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "example": {
                  "detail": "No se pudo comprobar PostgreSQL"
                },
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "La API está viva, pero PostgreSQL no está disponible."
          }
        },
        "summary": "Comprueba la conexión a PostgreSQL",
        "tags": [
