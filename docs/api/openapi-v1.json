    "/v1/sesion/evaluador": {
      "post": {
        "description": "Busca el DNI en core.m_evaluador. Es una identificación interna temporal; todavía no crea tokens ni sustituye la autenticación futura del panel.",
        "operationId": "resolverEvaluador",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluadorIdentificacion"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluadorSesion"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "example": {
                  "detail": "El DNI no corresponde a un evaluador activo del maestro"
                },
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "El DNI no pertenece a un evaluador activo."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "example": {
                  "detail": "No se pudo consultar el maestro de evaluadores"
                },
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "PostgreSQL no está disponible o el maestro no pudo consultarse."
          }
        },
        "summary": "Resuelve un evaluador activo por DNI",
        "tags": [
          "Sesión interna"
        ]
      }
    },
