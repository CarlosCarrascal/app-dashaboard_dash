root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# El motor de PostgreSQL y el de Power BI leen estos archivos: UTF-8 sin BOM es obligatorio.
# Hay 5 objetos cuyo nombre lleva ñ o acento y debe sobrevivir intacto
# (R0801_ResCampaña, H0105_RendTurno_paña, R0802_ResumenAño,
#  R0801_Forecast_Campaña_SemMes, R0902_Forecast_Sem_vs_Camp).
[*.sql]
indent_size = 4

[*.py]
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{yml,yaml,json,ts,tsx,js,jsx}]
indent_size = 2

[*.tmdl]
indent_style = tab
