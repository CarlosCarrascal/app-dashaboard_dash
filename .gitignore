# Secretos
.env
.env.local
*.pgpass

# Datos: el repositorio versiona código y contratos, no datos
data/entrada/*
data/salida/*
!data/entrada/.gitkeep
!data/salida/.gitkeep
*.accdb
*.laccdb
*.mdb

# Power BI: el .pbix es binario; se versiona el TMDL de bi/semantic-model/
*.pbix
*.pbit
**/.pbi/cache.abf
**/.pbi/localSettings.json

# Node
node_modules/
.next/
out/
dist/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Herramientas
.idea/
.vscode/*
!.vscode/extensions.json
*.log
.DS_Store
Thumbs.db

# Terraform
.terraform/
*.tfstate
*.tfstate.*

# Tablero Dash: el binario standalone de Tailwind no es una dependencia npm (ADR-0006) —
# cada equipo lo descarga una vez (ver scripts/run.mjs::findTailwind) — y la caché de
# Serverside son archivos temporales locales, no estado a versionar.
apps/dashboard/bin/
apps/dashboard/.cache/
.md