{
  "name": "aquanqa-data-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de datos Aqu Anqa: PostgreSQL como código, ETL del histórico de Access, API de campo y modelo semántico de BI",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "comentario": "Node solo actúa de lanzador de tareas: scripts/run.mjs localiza psql y el Python de conda para que no haya que activar nada a mano. No hay dependencias npm ni código TypeScript; el backend, la validación y el ETL son Python (ADR-0006).",
  "scripts": {
    "setup": "node scripts/run.mjs setup",
    "extract": "node scripts/run.mjs py extract",
    "load": "node scripts/run.mjs py load",
    "build": "node scripts/run.mjs build",
    "validate": "node scripts/run.mjs validate",
    "dashboard": "node scripts/run.mjs dashboard",
    "dashboard:dash": "node scripts/run.mjs dashboard",
    "dashboard:dash:css": "node scripts/run.mjs tailwind",
    "dashboard:dash:css:watch": "node scripts/run.mjs tailwind --watch",
    "analytics:relations": "node scripts/run.mjs analytics relations",
    "analytics:backtest": "node scripts/run.mjs analytics backtest",
    "analytics:train": "node scripts/run.mjs analytics train",
    "analytics:project": "node scripts/run.mjs analytics project",
    "analytics:validate-operational": "node scripts/run.mjs analytics validate-operational",
    "analytics:operational-project": "node scripts/run.mjs analytics operational-project",
    "analytics:bhattacharya": "node scripts/run.mjs analytics bhattacharya",
    "analytics:export": "node scripts/run.mjs analytics export",
    "analytics:mlflow": "node scripts/run.mjs mlflow",
    "migrate": "node scripts/run.mjs migrate",
    "psql": "node scripts/run.mjs psql",
    "sql": "node scripts/run.mjs sql",
    "db:reset": "node scripts/run.mjs psql -f db/tools/reset_modelo.sql"
  }
}
