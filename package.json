{
  "name": "aquanqa-data-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de datos Aqu Anqa: migración de BD_AQUANQA_26.accdb a PostgreSQL, app de captura y modelo semántico de BI",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "node scripts/run.mjs setup",
    "extract": "node scripts/run.mjs py extract",
    "load": "node scripts/run.mjs py load",
    "build": "node scripts/run.mjs build",
    "validate": "node scripts/run.mjs validate",
    "migrate": "node scripts/run.mjs migrate",
    "psql": "node scripts/run.mjs psql",
    "sql": "node scripts/run.mjs sql",
    "db:pull": "npm run db:pull -w @aquanqa/db",
    "db:check": "npm run db:check -w @aquanqa/db",
    "dev": "npm run dev -w @aquanqa/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
